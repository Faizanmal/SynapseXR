<!--
  Panel, Button, ButtonIcon, and ButtonLabel come from the bundled Horizon kit.
  RectangleGoggles and LogIn are bundled Lucide icon components. The :dark
  styles apply because iwsdk.config.json prefers the dark color scheme.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 480px;
  }

  .panel-content {
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }

  .eyebrow {
    color: #00e5ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .heading {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
    line-height: 32px;
  }

  .body {
    color: #b0bec5;
    font-size: 16px;
    line-height: 22px;
  }

  .button-group {
    flex-direction: row;
    gap: 12px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
  }

  .button {
    flex-grow: 1;
    justify-content: center;
  }

  .button-label {
    transform-translate-y: 1px;
    font-weight: 600;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">SYNAPSEXR // AI INCIDENT COMMAND</div>
    <div class="heading">Contain the Retrieval Leak</div>
    <div class="body">Run a synthetic incident through triage, evidence review, containment planning, and human sign-off.</div>
    <div class="body">1. Inspect the incident commander and evidence analyst.</div>
    <div class="body">2. Review a scoped quarantine plan with rollback.</div>
    <div class="body">3. Approve or reject the simulated response. No live systems are changed.</div>
  </div>
  <div class="button-group">
    <Button id="xr-button" class="button">
      <ButtonIcon>
        <RectangleGoggles></RectangleGoggles>
      </ButtonIcon>
      <ButtonLabel class="button-label">Enter XR</ButtonLabel>
    </Button>
    <Button id="exit-button" class="button" style="display: none">
      <ButtonIcon>
        <LogIn></LogIn>
      </ButtonIcon>
      <ButtonLabel class="button-label">Exit XR</ButtonLabel>
    </Button>
  </div>
</Panel>
