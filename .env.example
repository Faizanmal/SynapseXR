# AgentSphere Environment Configuration Template
# Copy this file to .env.local for local overrides. Never commit actual secret keys.

# Environment Mode
VITE_APP_MODE=development
VITE_DEMO_MODE=true

# AI Backend Service URL (FastAPI)
VITE_BACKEND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Optional IWSDK Example Assets CDN override
# VITE_IWSDK_EXAMPLE_ASSET_BASE_URL=https://cdn.jsdelivr.net/npm/@iwsdk/example-assets@0.4.2/assets
