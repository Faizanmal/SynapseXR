# AgentSphere FastAPI backend configuration template.
# Copy to backend/.env (git-ignored) or set as Cloud Run secrets/env vars.
# NEVER put provider keys in the frontend (.env with VITE_ prefix) - they would ship in the browser bundle.

ENVIRONMENT=development

# LLM provider: auto | none | gemini | openai
#   auto  -> gemini if GEMINI_API_KEY is set, else openai if OPENAI_API_KEY is set, else deterministic demo mode
#   none  -> always deterministic demo mode (no paid calls)
LLM_PROVIDER=auto
# LLM_MODEL=gemini-2.5-flash

# Google Gemini (sent via x-goog-api-key header, never in URLs or logs)
GEMINI_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (e.g. local Ollama at http://localhost:11434/v1, no key needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Provider call limits
REQUEST_TIMEOUT_S=30
MAX_RETRIES=2
RETRY_BACKOFF_S=0.5
AGENT_TIMEOUT_S=90
MAX_OUTPUT_TOKENS=2048
MAX_PROMPT_CHARS=24000
MAX_RESPONSE_CHARS=60000

# HTTP hardening
MAX_REQUEST_BYTES=262144
# Comma-separated strict allowlist ("*" is rejected)
ALLOWED_ORIGINS=https://localhost:8081,http://localhost:8081
RATE_LIMIT_EXECUTE_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=120
# Only enable when running behind a trusted proxy (e.g. Cloud Run) that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Optional shared bearer token for /api/agent/* (server-to-server or gateway use; do not embed in browser bundles)
ACCESS_TOKEN=

