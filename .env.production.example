# ==========================================
# SynapseXR Production Environment Configuration
# ==========================================

# Production domain / host (e.g., https://synapsexr.yourdomain.com or https://localhost:8443)
PUBLIC_DOMAIN=localhost
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# Production AI Backend Settings
ENVIRONMENT=production
LLM_PROVIDER=auto
# GEMINI_API_KEY=your-production-gemini-key
# OPENAI_API_KEY=your-production-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Rate Limiting
MAX_REQUEST_BYTES=262144
RATE_LIMIT_EXECUTE_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=120
TRUST_PROXY_HEADERS=true

# CORS Allowlist (comma separated)
ALLOWED_ORIGINS=https://localhost,http://localhost,https://localhost:8443,http://localhost:8081
